@section Scripts {
    <script>
        var aktifDonemTipi = 'Aylik';

        $(document).ready(function() {
            var bugun = new Date().toISOString().split('T')[0];
            $('#islemTarih').val(bugun);
            $('#filtreGun').val(bugun);
            donemYenile();
        });

        function tamEkranBorclularAc() {
            $('#borcMusteriAraInput').val('');
            borcluMusteriFiltrele();
            $('#modalMusteriBorclariTamEkran').modal('show');
        }

        function borcluMusteriFiltrele() {
            var aranan = $('#borcMusteriAraInput').val().toLowerCase().trim();
            var gorunen = 0;
            var toplam = 0;

            $('#tamEkranBorcluTbody tr.borclu-satir').each(function() {
                toplam++;
                var metin = $(this).find('.aranan-metin').text().toLowerCase();
                if (metin.indexOf(aranan) > -1) {
                    $(this).show();
                    gorunen++;
                } else {
                    $(this).hide();
                }
            });

            if (aranan === "") {
                $('#borcluGosterilenSayi').text('Toplam ' + toplam + ' kayıt listeleniyor');
            } else {
                $('#borcluGosterilenSayi').text('"' + aranan + '" araması için ' + gorunen + ' sonuç bulundu');
            }
        }

        function donemTipDegistir(tip, btn) {
            aktifDonemTipi = tip;
            $('.donem-btn').removeClass('active btn-dark').addClass('btn-outline-secondary');
            $(btn).removeClass('btn-outline-secondary').addClass('active btn-dark');

            if (tip === 'Gunluk') {
                $('#filtreGun').show();
                $('#filtreAy, #filtreYil').hide();
            } else if (tip === 'Aylik') {
                $('#filtreGun').hide();
                $('#filtreAy, #filtreYil').show();
            } else {
                $('#filtreGun, #filtreAy').hide();
                $('#filtreYil').show();
            }
            donemYenile();
        }

        function donemYenile() {
            var yil = $('#filtreYil').val();
            var ay = $('#filtreAy').val();
            var gun = $('#filtreGun').val();

            $.get('/Finans/GetDonemOzeti', { tip: aktifDonemTipi, yil: yil, ay: ay, gun: gun }, function(res) {
                $('#seciliDonemBaslik').text(res.aciklama);
                $('#modalDonemBaslik').text(res.aciklama + ' — İşlem Dökümü');
                $('#ozetGelir').text(res.gelir + ' TL');
                $('#ozetGider').text(res.gider + ' TL');
                $('#ozetNet').text(res.net + ' TL')
                    .removeClass('text-success text-danger')
                    .addClass(res.isPositive ? 'text-success' : 'text-danger');
                $('#donemIslemSayisi').text(res.islemSayisi);

                var html = '';
                if (res.hareketler && res.hareketler.length > 0) {
                    res.hareketler.forEach(function(h) {
                        var renk = h.isPositive ? 'text-success' : 'text-danger';
                        var isaret = h.isPositive ? '+' : '-';
                        html += `<div class="data-row">
                                    <div><div class="r-title">${h.baslik}</div><div class="r-sub">${h.tarih} — ${h.tur}</div></div>
                                    <div class="r-amount ${renk}">${isaret} ${h.tutar} TL</div>
                                 </div>`;
                    });
                } else {
                    html = '<div class="p-4 text-center text-muted">Bu dönemde kayıtlı işlem bulunmuyor.</div>';
                }
                $('#donemHareketleriListesi').html(html);
            });
        }

        function musteriSecimDegisti() {
            if ($('#islemMusteriId').val() !== "") {
                $('#manuelMuhatapDiv').hide();
            } else {
                $('#manuelMuhatapDiv').show();
            }
        }

        function islemModalAc(tur) {
            $('#islemTuru').val(tur);
            $('#islemTutar, #islemAciklama, #islemMuhatapAd').val('');
            $('#islemMusteriId').val('');
            musteriSecimDegisti();

            if (tur === 'Manuel Alacak') {
                $('#islemModalTitle').text('Yeni Alacak / Borçlu Kaydı');
                $('#kisiSecimAlani').show();
            } else if (tur === 'Gider') {
                $('#islemModalTitle').text('Yeni Gider Kaydı');
                $('#kisiSecimAlani').hide();
            } else {
                $('#islemModalTitle').text('Yeni Ek Gelir Kaydı');
                $('#kisiSecimAlani').hide();
            }
            $('#modalFinansIslem').modal('show');
        }

        function islemKaydet() {
            var data = {
                tur: $('#islemTuru').val(),
                tutar: $('#islemTutar').val(),
                aciklama: $('#islemAciklama').val(),
                tarih: $('#islemTarih').val(),
                musteriId: $('#islemMusteriId').val(),
                muhatapIsim: $('#islemMuhatapAd').val()
            };
            if (!data.tutar || !data.aciklama) { alert("Lütfen tutar ve açıklama alanlarını doldurunuz."); return; }
            if (data.tur === 'Manuel Alacak' && !data.musteriId && !data.muhatapIsim) {
                alert("Lütfen borçlu müşteriyi seçin veya kişi/kurum adını yazın."); return;
            }

            $.post('/Finans/FinansIslemEkle', data, function(res) {
                if (res.success) location.reload();
                else alert(res.mesaj);
            });
        }

        function odemeAlModalAc() {
            $('#odemeMusteriId').val('');
            $('#odemeTutar, #odemeAciklama').val('');
            $('#modalOdemeAl').modal('show');
        }

        function hizliOdemeAl(musteriId, kalanTutar) {
            $('#odemeMusteriId').val(musteriId);
            $('#odemeTutar').val(kalanTutar);
            $('#odemeAciklama').val('');
            $('#modalOdemeAl').modal('show');
        }

        function odemeKaydet() {
            var mId = $('#odemeMusteriId').val();
            var tutar = $('#odemeTutar').val();
            if (!mId || !tutar || tutar <= 0) { alert("Lütfen müşteriyi seçip geçerli bir tutar girin."); return; }

            $.post('/Finans/OdemeAl', {
                musteriId: mId,
                tutar: tutar,
                yontem: $('#odemeYontem').val(),
                aciklama: $('#odemeAciklama').val()
            }, function(res) {
                if (res.success) location.reload();
                else alert(res.mesaj);
            });
        }

        function manuelAlacakTahsilModal(id, kisi, tutar) {
            $('#manuelTahsilId').val(id);
            $('#manuelTahsilKisi').text('Borçlu: ' + kisi);
            $('#manuelTahsilTutar').val(tutar);
            $('#modalManuelTahsil').modal('show');
        }

        function manuelAlacakTahsilKaydet() {
            $.post('/Finans/ManuelAlacakTahsilEt', {
                id: $('#manuelTahsilId').val(),
                tutar: $('#manuelTahsilTutar').val(),
                yontem: $('#manuelTahsilYontem').val()
            }, function(res) {
                if (res.success) location.reload();
                else alert(res.mesaj);
            });
        }

        function tedarikciEkle() {
            var ad = $('#tedAd').val();
            if (!ad) { alert("Firma veya kişi adı zorunludur."); return; }
            $.post('/Finans/TedarikciEkle', {
                ad: ad,
                telefon: $('#tedTel').val(),
                sektor: $('#tedSektor').val(),
                bakiye: $('#tedBakiye').val()
            }, function(res) {
                if (res.success) location.reload();
                else alert(res.mesaj);
            });
        }

        function tedarikciOdemeAc(id, ad, bakiye) {
            $('#odenecekTedarikciId').val(id);
            $('#odenecekTedarikciAd').text(ad + ' (Borç: ' + bakiye + ' ₺)');
            $('#tedOdemeTutar').val(bakiye);
            $('#tedOdemeAciklama').val('');
            $('#modalTedarikciOdeme').modal('show');
        }

        function tedarikciOdemeKaydet() {
            $.post('/Finans/TedarikciOdemeYap', {
                tedarikciId: $('#odenecekTedarikciId').val(),
                tutar: $('#tedOdemeTutar').val(),
                aciklama: $('#tedOdemeAciklama').val()
            }, function(res) {
                if (res.success) location.reload();
                else alert("Lütfen geçerli bir tutar giriniz.");
            });
        }

        function tedarikciSil(id) {
            if (confirm("Bu tedarikçi kaydını silmek istediğinize emin misiniz?")) {
                $.post('/Finans/TedarikciSil', { id: id }, function(res) {
                    if (res.success) location.reload();
                });
            }
        }

        function hareketDetayGoster(baslik, tur, tarih, tutar, detay) {
            $('#detayBaslik').text(baslik);
            $('#detayTur').text(tur);
            $('#detayTarih').text(tarih);
            $('#detayTutar').text(tutar);
            $('#detayAciklama').text(detay);
            $('#modalHareketDetay').modal('show');
        }

        function hareketSil(id, isMusteri) {
            if (confirm("Bu işlemi silmek istediğinize emin misiniz?")) {
                $.post('/Finans/HareketSil', { id: id, isMusteri: isMusteri }, function(res) {
                    if (res.success) location.reload();
                    else alert("Kayıt silinemedi.");
                });
            }
        }
    </script>
}