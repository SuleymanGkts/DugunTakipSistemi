@{
    ViewData["Title"] = "Gösterge Paneli";
}

<h2 class="mb-4">Gösterge Paneli</h2>

<div class="row">
    <!-- Ciro Kartı -->
    <div class="col-md-3 mb-4">
        <div class="card bg-primary text-white h-100 shadow-sm border-0">
            <div class="card-body py-4">
                <h6 class="card-title text-uppercase text-white-50">Bu Ayki Ciro</h6>
                <h2 class="display-6 fw-bold mb-0">125.000 ₺</h2>
            </div>
        </div>
    </div>

    <!-- Bekleyen Alacak Kartı -->
    <div class="col-md-3 mb-4">
        <div class="card bg-warning text-dark h-100 shadow-sm border-0">
            <div class="card-body py-4">
                <h6 class="card-title text-uppercase text-dark-50">Bekleyen Alacaklar</h6>
                <h2 class="display-6 fw-bold mb-0">45.000 ₺</h2>
            </div>
        </div>
    </div>

    <!-- Yaklaşan Rezervasyonlar Kartı -->
    <div class="col-md-3 mb-4">
        <div class="card bg-success text-white h-100 shadow-sm border-0">
            <div class="card-body py-4">
                <h6 class="card-title text-uppercase text-white-50">Bu Haftaki İşler</h6>
                <h2 class="display-6 fw-bold mb-0">8 Rezervasyon</h2>
            </div>
        </div>
    </div>

    <!-- Toplam Gider Kartı -->
    <div class="col-md-3 mb-4">
        <div class="card bg-danger text-white h-100 shadow-sm border-0">
            <div class="card-body py-4">
                <h6 class="card-title text-uppercase text-white-50">Aylık Gider</h6>
                <h2 class="display-6 fw-bold mb-0">12.500 ₺</h2>
            </div>
        </div>
    </div>
</div>

<div class="row mt-2">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Yaklaşan Etkinlikler</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">Buraya takvimdeki en yakın 5 işin listesi gelecek.</p>
            </div>
        </div>
    </div>
</div>